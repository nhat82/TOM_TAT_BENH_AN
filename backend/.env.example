GEMINI_API_KEY=

# Full-privilege connection used by the application (CRUD).
DB_URL=

# Read-only connection used only by the agent's SQL tools.
# Must point to a role with SELECT on the agent views and no write privileges.
AGENT_DB_URL=

# "api" (Comet-hosted, needs OPIK_API_KEY) or "self-host"
OPIK_HOST=self-host
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=